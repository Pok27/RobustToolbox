#version 140

uniform vec2 TEXTURE_PIXEL_SIZE;
uniform vec2 SCREEN_PIXEL_SIZE;

in vec2 UV;
out vec4 COLOR;

void main() {
    vec2 uv = UV;
    vec2 texSize = TEXTURE_PIXEL_SIZE;
    vec2 screenSize = SCREEN_PIXEL_SIZE;
    
    // Calculate scale factors
    vec2 scale = screenSize / texSize;
    float scaleFactor = max(scale.x, scale.y);
    
    // Point sampling algorithm:
    // - For downscaling (scale < 1): Use nearest neighbor for crisp pixels
    // - For upscaling (scale > 1): Use weighted bilinear interpolation
    // - For 1:1 scale: Use nearest neighbor
    
    if (scaleFactor < 0.95) {
        // Downscaling - use nearest neighbor for crisp pixels
        vec2 texCoord = floor(uv * texSize) / texSize;
        COLOR = texture(TEXTURE, texCoord);
    } else if (scaleFactor > 1.05) {
        // Upscaling - use weighted bilinear interpolation
        vec2 texCoord = uv * texSize;
        vec2 texCoordFloor = floor(texCoord);
        vec2 texCoordFract = fract(texCoord);
        
        // Sample 4 nearest pixels
        vec4 c00 = texture(TEXTURE, (texCoordFloor + vec2(0.0, 0.0)) / texSize);
        vec4 c10 = texture(TEXTURE, (texCoordFloor + vec2(1.0, 0.0)) / texSize);
        vec4 c01 = texture(TEXTURE, (texCoordFloor + vec2(0.0, 1.0)) / texSize);
        vec4 c11 = texture(TEXTURE, (texCoordFloor + vec2(1.0, 1.0)) / texSize);
        
        // Bilinear interpolation with edge preservation
        vec4 c0 = mix(c00, c10, texCoordFract.x);
        vec4 c1 = mix(c01, c11, texCoordFract.x);
        COLOR = mix(c0, c1, texCoordFract.y);
    } else {
        // 1:1 scale - use nearest neighbor
        vec2 texCoord = floor(uv * texSize) / texSize;
        COLOR = texture(TEXTURE, texCoord);
    }
}